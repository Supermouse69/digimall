{
  "name": "digimall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "generate:types": "bun tsx ./node_modules/payload/bin.js generate:types",
    "db:fresh": "tsx ./node_modules/payload/dist/bin/index.js migrate:fresh",
    "db:seed": "bun run src/seed.ts",
    "db:reset": "bun run db:fresh && bun run db:seed",
    "test:access": "tsx scripts/check-access.ts",
    "seed:mock": "tsx --env-file=.env scripts/seed-mock-products.ts",
    "db:migrate": "bun tsx ./node_modules/payload/bin.js migrate",
    "db:migrate:status": "bun tsx ./node_modules/payload/bin.js migrate:status",
    "test:redirects": "tsx scripts/check-redirects.ts",
    "test:signup": "tsx scripts/check-signup-rules.ts",
    "test:emails": "tsx scripts/check-emails.ts",
    "test:invites": "tsx --env-file=.env scripts/check-invites.ts",
    "test:rider-docs": "tsx --env-file=.env scripts/check-rider-documents.ts",
    "admin:reset-2fa": "tsx --env-file=.env scripts/reset-admin-2fa.ts",
    "test:2fa": "tsx scripts/check-two-factor.ts",
    "test:admin-login": "tsx --env-file=.env scripts/check-admin-login.ts",
    "test:bot-protection": "tsx --env-file=.env scripts/check-bot-protection.ts",
    "notes:map": "bun scripts/update-code-map.mjs"
  },
