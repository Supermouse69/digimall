# Copy this file to .env and fill in real values. Never commit .env.
# Use a DIFFERENT database for development and production.

# --- Payload ---
# Long random string (32+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PAYLOAD_SECRET=change-me

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers).
# The part after ".net/" is the database name, e.g. digimall-dev
DATABASE_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/digimall-dev

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Store pages live at /store/[slug], not on subdomains (DNS is on Cloudflare)
NEXT_PUBLIC_ENABLE_SUBDOMAIN_ROUTING=false

# --- Super-admin hidden login ---
# The super-admin logs in ONLY at /admin-entry/<ADMIN_ENTRY_PATH> (with 2-step login).
# Use a long random value (at least 16 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_ENTRY_PATH=change-me-to-a-long-random-value

# --- Bot protection (Cloudflare Turnstile) ---
# Development: Cloudflare's official TEST keys below (always pass, no account needed).
# Production: create a widget for digimall.online in the Cloudflare dashboard -> Turnstile,
# and put the real keys in Vercel's environment variables (never in git).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Scheduled jobs ---
# Protects /api/cron/* (daily chat cleanup). Long random value (32+ chars). Vercel Cron sends it
# as "Authorization: Bearer <CRON_SECRET>". Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=change-me-to-a-long-random-value

# --- Web push notifications (VAPID) ---
# Free, no account. Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Use a different pair for production. The private key must stay secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me

# ======================= PRODUCTION ONLY (Vercel environment variables) =======================
# Locally these can stay empty: files are saved in ./media and ./private-media and emails print
# to the terminal. On Vercel the app refuses to start without the storage settings.

# --- Public images (product photos, logos): Vercel Blob (PUBLIC store) ---
# Vercel -> Storage -> Create -> Blob -> connect to the project (adds this automatically)
BLOB_READ_WRITE_TOKEN=

# --- Private files (IDs, licenses, receipts, GCash QRs, landmark + chat photos): Cloudflare R2 ---
# Cloudflare -> R2 -> Create bucket (keep it PRIVATE, no public access) -> Manage R2 API Tokens
# -> "Object Read & Write" for that bucket only.
R2_BUCKET=digimall-private
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Email: Resend (resend.com) with the digimall.online domain verified ---
RESEND_API_KEY=
EMAIL_FROM=no-reply@digimall.online
