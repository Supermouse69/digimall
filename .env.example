# Copy this file to .env and fill in real values. Never commit .env.
# Use a DIFFERENT database for development and production.

# --- Payload ---
# Long random string (32+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PAYLOAD_SECRET=change-me

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers).
# The part after ".net/" is the database name, e.g. digimall-dev
DATABASE_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/digimall-dev

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Store pages live at /store/[slug], not on subdomains (DNS is on Cloudflare)
NEXT_PUBLIC_ENABLE_SUBDOMAIN_ROUTING=false

# --- Super-admin hidden login ---
# The super-admin logs in ONLY at /admin-entry/<ADMIN_ENTRY_PATH> (with 2-step login).
# Use a long random value (at least 16 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_ENTRY_PATH=change-me-to-a-long-random-value
